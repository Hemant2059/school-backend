# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------
DATABASE_URL="postgresql://school:school@localhost:5433/school?schema=public"

# ---------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------
NODE_ENV="development"
PORT=3000

# ---------------------------------------------------------------------
# Auth
#
# Both secrets must be at least 32 characters and different from each
# other. The application refuses to start otherwise, so a deployment can
# never silently fall back to a well-known development key.
#
#   openssl rand -base64 48
# ---------------------------------------------------------------------
JWT_SECRET="change-me-to-a-long-random-value-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-value-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ---------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------
# Comma separated list of allowed CORS origins. Empty disables CORS.
CORS_ORIGINS=""
# The Swagger UI is always available in development. Set to true to expose
# it in production as well.
SWAGGER_ENABLED="false"
# Rate limiting: window length in milliseconds and the requests per window.
THROTTLE_TTL=60000
THROTTLE_LIMIT=300

# ---------------------------------------------------------------------
# Seed (optional)
#
# The seed refuses to invent a password in production; set both of these
# to a value of at least 12 characters there.
# ---------------------------------------------------------------------
SUPER_ADMIN_EMAIL="superadmin@platform.local"
SUPER_ADMIN_PASSWORD="ChangeMe123!"
TENANT_USER_EMAIL="tenantadmin@example.com"
TENANT_USER_PASSWORD="ChangeMe123!"
