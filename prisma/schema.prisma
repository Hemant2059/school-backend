  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollment StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  route      TransportRoute    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop       TransportStop?    @relation(fields: [stopId], references: [id], onDelete: SetNull)
  vehicle    TransportVehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
  @@index([enrollmentId])
  @@index([deletedAt])
}

enum BookIssueStatus {
  ISSUED
  RETURNED
  OVERDUE
  LOST
}

model LibraryBook {
  id       String @id @default(uuid())
  tenantId String

  titleEn         String
  titleNe         String
  authorEn        String?
  authorNe        String?
  isbn            String?
  category        String?
  totalCopies     Int     @default(1)
  availableCopies Int     @default(1)

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  issues BookIssue[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
  @@index([deletedAt])
}

model BookIssue {
  id        String @id @default(uuid())
  tenantId  String
  bookId    String
  studentId String

  issueDateAd  DateTime
  issueDateBs  String?   @db.VarChar(10)
  dueDateAd    DateTime
  dueDateBs    String?   @db.VarChar(10)
  returnDateAd DateTime?
  returnDateBs String?   @db.VarChar(10)

  fineAmount Decimal         @default(0) @db.Decimal(10, 2)
  status     BookIssueStatus @default(ISSUED)

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  book    LibraryBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
  @@index([bookId])
  @@index([studentId])
  @@index([deletedAt])
}

enum HostelType {
  BOYS
  GIRLS
  MIXED
}

model Hostel {
  id       String @id @default(uuid())
  tenantId String

  nameEn        String
  nameNe        String
  type          HostelType @default(MIXED)
  capacity      Int?
  wardenStaffId String?

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warden StaffProfile? @relation(fields: [wardenStaffId], references: [id], onDelete: SetNull)

  rooms       HostelRoom[]
  allocations HostelAllocation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
  @@index([deletedAt])
}

model HostelRoom {
  id       String @id @default(uuid())
  tenantId String
  hostelId String

  roomNumber String
  floor      Int?
  capacity   Int?
  roomType   String?

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hostel      Hostel             @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  allocations HostelAllocation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
  @@index([hostelId])
  @@index([deletedAt])
}

model HostelAllocation {
  id           String @id @default(uuid())
  tenantId     String
  hostelId     String
  roomId       String
  enrollmentId String

  startDate DateTime
  endDate   DateTime?
  status    String    @default("ACTIVE")

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hostel     Hostel            @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  room       HostelRoom        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  enrollment StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
  @@index([hostelId])
  @@index([roomId])
  @@index([enrollmentId])
  @@index([deletedAt])
}

enum NotificationRecipientType {
  USER
  PLATFORM_USER
}

model Notification {
  id       String  @id @default(uuid())
  tenantId String?

  recipientType NotificationRecipientType
  recipientId   String

  title    String
  message  String
  type     String?
  isRead   Boolean   @default(false)
  readAt   DateTime?
  metadata Json?

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
  @@index([recipientType, recipientId])
  @@index([isRead])
  @@index([deletedAt])
}
