// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Platform-side users: SaaS company internal staff, support engineers,
/// billing admins, auditors and regional sales partners.
enum PlatformUserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model PlatformUser {
  id          String  @id @default(uuid())
  email       String  @unique
  firstNameEn String
  firstNameNe String
  lastNameEn  String
  lastNameNe  String
  phone       String? @unique

  passwordHash String?

  status PlatformUserStatus @default(INVITED)

  province String?
  district String?
  address  String?

  emailVerifiedAt     DateTime?
  phoneVerifiedAt     DateTime?
  twoFactorEnabled    Boolean   @default(false)
  twoFactorSecret     String?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  passwordChangedAt   DateTime?
  mustChangePassword  Boolean   @default(false)

  invitationToken      String?   @unique
  invitationExpiresAt  DateTime?
  invitationAcceptedAt DateTime?

  refreshTokenHash      String?
  refreshTokenExpiresAt DateTime?

  roles       PlatformUserRole[]
  permissions PlatformUserPermission[]

  invitedById  String?
  invitedBy    PlatformUser?  @relation("PlatformUserInvites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers PlatformUser[] @relation("PlatformUserInvites")

  assignedRoles      PlatformUserRole[]       @relation("AssignedRoles")
  grantedPermissions PlatformUserPermission[] @relation("GrantedPermissions")

  createdOrganizations  Organization[] @relation("CreatedOrganizations")
  resellerOrganizations Organization[] @relation("ResellerOrganizations")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([province, district])
  @@index([deletedAt])
  @@index([createdAt])
}

model PlatformRole {
  id          String  @id @default(uuid())
  name        String
  description String?
  isSystem    Boolean @default(false)

  permissions PlatformRolePermission[]
  users       PlatformUserRole[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
}

model PlatformPermission {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?
  category    String?

  roles PlatformRolePermission[]
  users PlatformUserPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformRolePermission {
  roleId       String
  permissionId String
  grantedAt    DateTime @default(now())

  role       PlatformRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission PlatformPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model PlatformUserRole {
  userId       String
  roleId       String
  assignedAt   DateTime @default(now())
  assignedById String?

  user       PlatformUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       PlatformRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy PlatformUser? @relation("AssignedRoles", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
}

model PlatformUserPermission {
  userId       String
  permissionId String
  granted      Boolean  @default(true)
  grantedAt    DateTime @default(now())
  grantedById  String?

  user       PlatformUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission PlatformPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedBy  PlatformUser?      @relation("GrantedPermissions", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, permissionId])
  @@index([permissionId])
}

enum BillingCycle {
  MONTHLY
  YEARLY
  ONE_TIME
}

/// Dynamic features that can be enabled/configured per plan.
model Feature {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?
  category    String?
  isActive    Boolean @default(true)

  plans PlanFeature[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([category])
}

model SubscriptionPlan {
  id           String       @id @default(uuid())
  code         String       @unique
  name         String
  description  String?
  price        Decimal      @db.Decimal(12, 2)
  currency     String       @default("NPR")
  billingCycle BillingCycle
  trialDays    Int          @default(0)
  isActive     Boolean      @default(true)
  sortOrder    Int          @default(0)

  features PlanFeature[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]

  @@index([isActive])
  @@index([sortOrder])
}

/// Dynamic feature configuration for a plan.
model PlanFeature {
  planId    String
  featureId String
  isEnabled Boolean @default(true)
  /// Optional numeric limit (e.g. max students). Null means unlimited/included.
  limit     Int?
  /// Optional JSON configuration for the feature.
  config    Json?

  plan    SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature          @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([planId, featureId])
  @@index([featureId])
}

model Organization {
  id String @id @default(uuid())

  // Names (required)
  nameEn    String
  nameNe    String
  shortName String?

  // Legal / registration
  organizationType   OrganizationType @default(OTHER)
  registrationNumber String?
  panVatNumber       String?          @unique
  establishedDateAd  DateTime?
  establishedDateBs  String?          @db.VarChar(10)
  isTaxExempt        Boolean          @default(false)

  // Nepal address (required core)
  provinceCode     String
  provinceNe       String
  provinceEn       String?
  districtCode     String
  districtNe       String
  districtEn       String?
  municipalityCode String
  municipalityNe   String
  municipalityEn   String?
  wardNumber       Int
  toleEn           String?
  toleNe           String?
  addressEn        String?
  addressNe        String?

  // Contact (required core)
  phone              String
  email              String
  website            String?
  logoUrl            String?
  contactPersonName  String
  contactPersonPhone String
  contactPersonEmail String?

  // Fiscal / locale
  fiscalYearStartMonth Int    @default(7)
  timezone             String @default("Asia/Kathmandu")

  status OrganizationStatus @default(ACTIVE)
  notes  String?

  createdByPlatformUserId String
  resellerPartnerId       String?

  createdBy       PlatformUser  @relation("CreatedOrganizations", fields: [createdByPlatformUserId], references: [id], onDelete: Restrict)
  resellerPartner PlatformUser? @relation("ResellerOrganizations", fields: [resellerPartnerId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  tenants   Tenant[]

  @@index([createdByPlatformUserId])
  @@index([resellerPartnerId])
  @@index([status])
  @@index([provinceCode, districtCode, municipalityCode])
  @@index([deletedAt])
}

enum OrganizationType {
  TRUST
  FOUNDATION
  COMPANY
  NGO
  GOVERNMENT
  COOPERATIVE
  SCHOOL_GROUP
  OTHER
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id                    String     @id @default(uuid())
  email                 String?    @unique
  phone                 String?    @unique
  passwordHash          String?
  status                UserStatus @default(PENDING_VERIFICATION)
  firstNameEn           String
  firstNameNe           String
  lastNameEn            String
  lastNameNe            String
  profilePhotoUrl       String?
  lastLoginAt           DateTime?
  refreshTokenHash      String?
  refreshTokenExpiresAt DateTime?

  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  deletedAt               DateTime?
  tenantUsers             TenantUser[]
  students                Student[]
  guardians               Guardian[]
  examMarks               ExamMark[]
  feePayments             FeePayment[]
  creditNotes             CreditNote[]
  studentDailyAttendances StudentDailyAttendance[]

  @@index([status])
  @@index([deletedAt])
}

enum SchoolType {
  COMMUNITY
  INSTITUTIONAL_PRIVATE
  GUTHI
  COOPERATIVE
  RELIGIOUS
}

enum TenantStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
  INACTIVE
}

model Tenant {
  id             String  @id @default(uuid())
  organizationId String?

  nameEn String
  nameNe String

  subdomain          String @unique
  iemisCode          String @unique @db.VarChar(15)
  schoolCode         String @unique
  registrationNumber String
  panVatNumber       String

  schoolType SchoolType

  provinceCode     String
  provinceNe       String
  provinceEn       String
  districtCode     String
  districtNe       String
  districtEn       String
  municipalityCode String
  municipalityNe   String
  municipalityEn   String
  wardNumber       Int
  toleEn           String
  toleNe           String
  addressEn        String
  addressNe        String

  phone   String
  email   String
  website String?
  logoUrl String?

  establishedDateAd DateTime
  establishedDateBs String   @db.VarChar(10)

  motoEn String
  motoNe String

  latitude  Float
  longitude Float

  status TenantStatus @default(ONBOARDING)

  createdByPlatformUserId String

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  roles                     Role[]
  tenantUsers               TenantUser[]
  subscriptions             Subscription[]
  invoices                  Invoice[]
  academicYears             AcademicYear[]
  streams                   Stream[]
  gradeLevels               GradeLevel[]
  sections                  Section[]
  staffProfiles             StaffProfile[]
  subjects                  Subject[]
  gradeSubjects             GradeSubject[]
  students                  Student[]
  addresses                 Address[]
  guardians                 Guardian[]
  studentEnrollments        StudentEnrollment[]
  transferCertificates      TransferCertificate[]
  gradingScales             GradingScale[]
  exams                     Exam[]
  fiscalYears               FiscalYear[]
  feeHeads                  FeeHead[]
  classFeeStructures        ClassFeeStructure[]
  scholarshipSchemes        ScholarshipScheme[]
  studentScholarships       StudentScholarship[]
  feeInvoices               FeeInvoice[]
  feeInvoiceItems           FeeInvoiceItem[]
  feePayments               FeePayment[]
  creditNotes               CreditNote[]
  teacherSubjectAllocations TeacherSubjectAllocation[]
  payrollRuns               PayrollRun[]
  salarySlips               SalarySlip[]
  academicCalendarEvents    AcademicCalendarEvent[]
  studentDailyAttendances   StudentDailyAttendance[]
  timetableSlots            TimetableSlot[]
  transportVehicles         TransportVehicle[]
  transportRoutes           TransportRoute[]
  transportStops            TransportStop[]
  studentTransports         StudentTransport[]
  libraryBooks              LibraryBook[]
  bookIssues                BookIssue[]
  hostels                   Hostel[]
  hostelRooms               HostelRoom[]
  hostelAllocations         HostelAllocation[]
  notifications             Notification[]

  @@index([organizationId])
  @@index([status])
  @@index([schoolType])
  @@index([provinceCode, districtCode, municipalityCode])
  @@index([deletedAt])
}

model Permission {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?
  category    String?

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          String  @id @default(uuid())
  tenantId    String
  name        String
  description String?
  isSystem    Boolean @default(false)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       TenantUserRole[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
  @@index([deletedAt])
}

model RolePermission {
  roleId       String
  permissionId String
  grantedAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model TenantUser {
  id        String    @id @default(uuid())
  tenantId  String
  userId    String
  isPrimary Boolean   @default(false)
  status    String    @default("ACTIVE")
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles  TenantUserRole[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([status])
}

model TenantUserRole {
  tenantUserId String
  roleId       String
  assignedAt   DateTime @default(now())

  tenantUser TenantUser @relation(fields: [tenantUserId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([tenantUserId, roleId])
  @@index([roleId])
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  SUSPENDED
}

model Subscription {
  id          String             @id @default(uuid())
  tenantId    String
  planId      String
  status      SubscriptionStatus @default(TRIAL)
  startDate   DateTime
  endDate     DateTime
  trialEndsAt DateTime?
  cancelledAt DateTime?
  autoRenew   Boolean            @default(true)
  metadata    Json?

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([planId])
  @@index([status])
  @@index([endDate])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  VOID
  REFUNDED
}

model Invoice {
  id             String        @id @default(uuid())
  tenantId       String
  subscriptionId String?
  number         String        @unique
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("NPR")
  status         InvoiceStatus @default(ISSUED)
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  paidAt         DateTime?
  notes          String?

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  payments     Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([status])
  @@index([dueDate])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  ESEWA
  KHALTI
  CARD
  OTHER
}

model Payment {
  id             String        @id @default(uuid())
  invoiceId      String
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("NPR")
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  transactionRef String?
  paidAt         DateTime?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([status])
}

model AcademicYear {
  id       String @id @default(uuid())
  tenantId String

  name   String
  bsYear Int    @db.SmallInt

  startDateAd DateTime
  endDateAd   DateTime
  startDateBs String   @db.VarChar(10)
  endDateBs   String   @db.VarChar(10)

  isCurrent Boolean @default(false)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sections Section[]

  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  deletedAt                 DateTime?
  studentEnrollments        StudentEnrollment[]
  exams                     Exam[]
  classFeeStructures        ClassFeeStructure[]
  feeInvoices               FeeInvoice[]
  teacherSubjectAllocations TeacherSubjectAllocation[]
  academicCalendarEvents    AcademicCalendarEvent[]

  @@index([tenantId])
  @@index([isCurrent])
  @@index([deletedAt])
}

enum EvaluationType {
  PERCENTAGE
  GPA
  LETTER
  CGPA
}

model Stream {
  id       String @id @default(uuid())
  tenantId String

  code   String
  nameEn String
  nameNe String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  gradeLevels GradeLevel[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
  @@index([deletedAt])
}

model GradeLevel {
  id       String  @id @default(uuid())
  tenantId String
  streamId String?

  nameEn         String
  nameNe         String
  iemisGradeCode String?
  evaluationType EvaluationType @default(PERCENTAGE)
  sortOrder      Int            @default(0)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stream   Stream?   @relation(fields: [streamId], references: [id], onDelete: SetNull)
  sections Section[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  gradeSubjects      GradeSubject[]
  studentEnrollments StudentEnrollment[]
  classFeeStructures ClassFeeStructure[]

  @@index([tenantId])
  @@index([streamId])
  @@index([deletedAt])
}

model Section {
  id             String  @id @default(uuid())
  tenantId       String
  gradeLevelId   String
  academicYearId String?

  nameEn     String
  nameNe     String
  roomNumber String?
  capacity   Int?
  sortOrder  Int     @default(0)

  classTeacherId String?

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gradeLevel   GradeLevel          @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)
  academicYear AcademicYear?       @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  classTeacher StaffProfile?       @relation(fields: [classTeacherId], references: [id], onDelete: SetNull)
  enrollments  StudentEnrollment[]

  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  deletedAt                 DateTime?
  teacherSubjectAllocations TeacherSubjectAllocation[]
  studentDailyAttendances   StudentDailyAttendance[]
  timetableSlots            TimetableSlot[]

  @@index([tenantId])
  @@index([gradeLevelId])
  @@index([academicYearId])
  @@index([classTeacherId])
  @@index([deletedAt])
}

model StaffProfile {
  id       String  @id @default(uuid())
  tenantId String
  userId   String?

  employeeCode   String?
  iemisTeacherId String?

  firstNameEn  String
  firstNameNe  String?
  middleNameEn String?
  middleNameNe String?
  lastNameEn   String
  lastNameNe   String?

  gender Gender?

  casteEthnicityCode String?
  casteEthnicity     String?

  staffCategory  StaffCategory?
  employmentType EmploymentType?

  teachingLicenseNo     String?
  highestQualification  String?
  teacherTrainingStatus TeacherTrainingStatus?

  panNumber     String?
  pfNumber      String?
  citNumber     String?
  ssfNumber     String?
  bankAccountNo String?

  maritalStatusForTax MaritalStatusForTax?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  sections Section[]

  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  deletedAt                 DateTime?
  teacherSubjectAllocations TeacherSubjectAllocation[]
  salarySlips               SalarySlip[]
  timetableSlots            TimetableSlot[]
  transportVehicles         TransportVehicle[]
  hostels                   Hostel[]

  @@index([tenantId])
  @@index([deletedAt])
}

enum StaffCategory {
  TEACHING
  NON_TEACHING_ADMIN
  SUPPORT_DRIVER_HELPER
}

enum EmploymentType {
  GOVT_PERMANENT
  GOVT_TEMPORARY
  RAHAT_GRANT
  LOCAL_LEVEL_GRANT
  PRIVATE_SOURCE
  ECD_FACILITATOR
}

enum TeacherTrainingStatus {
  TPD_COMPLETED
  PARTIAL
  UNTRAINED
}

enum MaritalStatusForTax {
  SINGLE
  MARRIED
}

model Subject {
  id       String @id @default(uuid())
  tenantId String

  code        String
  nameEn      String
  nameNe      String
  description String?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gradeSubjects GradeSubject[]

  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  deletedAt                 DateTime?
  teacherSubjectAllocations TeacherSubjectAllocation[]
  timetableSlots            TimetableSlot[]

  @@index([tenantId])
  @@index([deletedAt])
}

model GradeSubject {
  id           String @id @default(uuid())
  tenantId     String
  gradeLevelId String
  subjectId    String

  creditHours         Int?
  theoryCreditHours   Int?
  internalCreditHours Int?
  theoryFullMarks     Decimal? @db.Decimal(6, 2)
  theoryPassMarks     Decimal? @db.Decimal(6, 2)
  internalFullMarks   Decimal? @db.Decimal(6, 2)
  internalPassMarks   Decimal? @db.Decimal(6, 2)
  isOptional          Boolean  @default(false)
  sortOrder           Int      @default(0)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gradeLevel    GradeLevel     @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)
  subject       Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  examSchedules ExamSchedule[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
  @@index([gradeLevelId])
  @@index([subjectId])
  @@index([deletedAt])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum DisabilityType {
  NONE
  PHYSICAL
  MENTAL
  DEAF
  BLIND
  LOW_VISION
  DEAF_BLIND
  SPEECH
  INTELLECTUAL
  AUTISM
  MULTIPLE
}

model Student {
  id       String  @id @default(uuid())
  tenantId String
  userId   String?

  admissionNo       String
  iemisStudentId    String? @db.VarChar(20)
  nebRegistrationNo String?
  symbolNo          String?

  firstNameEn  String
  firstNameNe  String
  middleNameEn String?
  middleNameNe String?
  lastNameEn   String
  lastNameNe   String

  dobAd DateTime
  dobBs String   @db.VarChar(10)

  gender             Gender
  casteEthnicityCode String
  casteEthnicity     String
  disabilityType     DisabilityType @default(NONE)

  motherTongue       String
  bloodGroup         String?
  birthCertificateNo String
  nationalIdNin      String

  hadEcdExperience Boolean @default(false)
  photoUrl         String?

  guardians StudentGuardian[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  studentEnrollments   StudentEnrollment[]
  transferCertificates TransferCertificate[]
  bookIssues           BookIssue[]

  @@index([tenantId])
  @@index([userId])
  @@index([deletedAt])
}

enum AddressEntityType {
  STUDENT
  STAFF
  GUARDIAN
  USER
  TENANT
  ORGANIZATION
  PLATFORM_USER
}

enum AddressType {
  PERMANENT
  TEMPORARY
}

enum AddressFormat {
  PROVINCIAL
  ZONAL
}

model Address {
  id       String @id @default(uuid())
  tenantId String

  entityType AddressEntityType
  entityId   String

  type   AddressType
  format AddressFormat

  // Provincial format
  provinceCode     String?
  provinceNe       String?
  provinceEn       String?
  districtCode     String?
  districtNe       String?
  districtEn       String?
  municipalityCode String?
  municipalityNe   String?
  municipalityEn   String?
  ward             Int?
  toleNe           String?
  toleEn           String?

  // Zonal format
  zoneCode String?
  zoneNe   String?
  zoneEn   String?
  vdcCode  String?
  vdcNe    String?
  vdcEn    String?
  village  String?

  latitude  Float?
  longitude Float?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([type])
  @@index([deletedAt])
}

enum GuardianRelationship {
